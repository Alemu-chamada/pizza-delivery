NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/pizza-delivery
CLIENT_ORIGIN=http://localhost:5173

# Auth / JWT
JWT_SECRET=placeholder_secret_key

# Google OAuth 2.0 (Customer-Only Authentication)
GOOGLE_CLIENT_ID=your_google_client_id_placeholder.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_placeholder
GOOGLE_CALLBACK_URL=http://localhost:5001/api/auth/google/callback

# Payment (Chapa Test Mode)
CHAPA_SECRET_KEY=CHASECK_TEST-your_chapa_test_secret_key_placeholder
# Note: Chapa API validator requires callback and return URLs to start with https://
# In local development without an HTTPS tunnel, leave them commented out.
# CHAPA_CALLBACK_URL=https://your-domain.com/api/orders/chapa/webhook
# CHAPA_RETURN_URL=https://your-domain.com/payment

# Email / Brevo SMTP
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USER=your_brevo_smtp_user_placeholder
EMAIL_PASS=your_brevo_smtp_pass_placeholder
EMAIL_FROM=orders@yourverifieddomain.com
ADMIN_ALERT_EMAIL=admin@example.com
CRON_SCHEDULE=*/30 * * * *
LOW_STOCK_THRESHOLD=20
